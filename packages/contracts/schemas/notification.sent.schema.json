{
  "event_type": "notification.sent",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "enum": [
        "SMS",
        "PUSH",
        "USSD",
        "EMAIL"
      ]
    },
    "recipient": {
      "type": "string",
      "minLength": 1
    },
    "template": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "channel",
    "recipient",
    "template"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}