{
  "event_type": "stock.hold_released",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "hold_id": {
      "type": "string",
      "format": "uuid"
    },
    "offer_id": {
      "type": "string",
      "format": "uuid"
    },
    "qty": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "reason": {
      "type": "string",
      "enum": [
        "EXPIRED",
        "CANCELLED",
        "FAILED"
      ]
    }
  },
  "required": [
    "hold_id",
    "offer_id",
    "qty",
    "reason"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}