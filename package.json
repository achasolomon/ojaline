{
  "name": "ojaline",
  "version": "0.1.0",
  "private": true,
  "description": "Ojaline — African local market platform. Modular monolith (ADR-005), outbox eventing (ADR-008).",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "db:migrate": "docker compose run --rm flyway migrate",
    "generate:schemas": "pnpm --filter @ojaline/contracts run generate:schemas"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  }
}
