# Copy to .env for local Docker Compose. NEVER commit .env (ADR-000 §5).
# Host ports are remappable if the machine already runs local services.

# Postgres (migration/superuser — runs Flyway)
POSTGRES_DB=ojaline
POSTGRES_USER=ojaline
POSTGRES_PASSWORD=ojaline_dev_pw
POSTGRES_PORT=5432

# Redis host port
REDIS_PORT=6379

# MinIO host ports
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=ojaline_minio
MINIO_ROOT_PASSWORD=ojaline_minio_pw

# Stub host ports (Africa's Talking + Paystack test-mode)
ATS_MOCK_PORT=9201
PAYSTACK_STUB_PORT=9202
ATS_API_KEY=ats_test_mock_key
PAYSTACK_SECRET_KEY=sk_test_ojaline_mock

# Application connection (same values Flyway uses; app role is created by V1)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ojaline
DB_USER=ojaline_app
DB_PASSWORD=ojaline_app_dev_pw
REDIS_URL=redis://localhost:6379

# API
API_PORT=3000
